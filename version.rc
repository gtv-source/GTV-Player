#pragma code_page(65001)
#include <winver.h>
#include "config-host.h"
/* generated by meson from gplayer/release-info.conf: edit that file */
#include "gplayer-version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GPLAYER_VERSION_BIN
PRODUCTVERSION GPLAYER_VERSION_BIN
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904B0"
    {
      VALUE "CompanyName", GPLAYER_COMPANY
      VALUE "ProductName", GPLAYER_PRODUCT
      VALUE "FileDescription", GPLAYER_DESCRIPTION
      VALUE "FileVersion", GPLAYER_VERSION_STR
      VALUE "ProductVersion", GPLAYER_VERSION_STR
      VALUE "LegalCopyright", GPLAYER_COPYRIGHT
      VALUE "Comments", "Based on QEMU (https://www.qemu.org), GNU GPL v2. QEMU is a trademark of Fabrice Bellard."
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0409, 1200
  }
}

IDI_ICON1 ICON "pc-bios/gtv.ico"
